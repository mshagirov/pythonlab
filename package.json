		"@wterm/dom": "^0.5.10",
		"@wterm/ghostty": "^0.5.10",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"shiki": "^4.6.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
